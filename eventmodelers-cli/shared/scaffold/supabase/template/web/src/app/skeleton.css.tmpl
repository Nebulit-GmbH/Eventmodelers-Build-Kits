/* Minimal styles for the skeleton's own markup, used when the model's screens name no CSS framework.
   Only the class names the app shell uses are covered. */
:root { font-family: system-ui, sans-serif; color: #222; background: #fafafa; }
body { margin: 0; }
.navbar { display: flex; align-items: center; gap: 1rem; padding: 0.5rem 1rem; background: #eee; }
.navbar-brand, .navbar-start, .navbar-end, .navbar-menu { display: flex; align-items: center; gap: 0.75rem; }
.navbar-menu { flex: 1; justify-content: space-between; }
.navbar-item { color: inherit; text-decoration: none; padding: 0.25rem 0.5rem; }
.navbar-item.is-active { background: #ddd; border-radius: 4px; }
.section { padding: 2rem 1rem; }
.container { max-width: 960px; margin: 0 auto; }
.title { font-size: 1.75rem; margin: 0 0 1rem; }
.title.is-5 { font-size: 1.15rem; }
.subtitle { color: #666; margin: 0 0 1rem; }
.notification { padding: 1rem; border-radius: 4px; background: #fff8e1; border: 1px solid #f0d58c; }
.tag { display: inline-block; padding: 0 0.5rem; border-radius: 4px; background: #eee; font-size: 0.8rem; }
.tag.is-success { background: #e3f6e8; } .tag.is-warning { background: #fff3cd; } .tag.is-danger { background: #fde2e1; }
.table { border-collapse: collapse; width: 100%; } .table th, .table td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid #ddd; }
.field { margin-bottom: 0.75rem; } .label { display: block; font-weight: 600; margin-bottom: 0.25rem; }
.input { width: 100%; padding: 0.4rem; box-sizing: border-box; }
.button { padding: 0.4rem 0.9rem; border: 1px solid #bbb; border-radius: 4px; background: #fff; cursor: pointer; }
.button.is-primary { background: #2a6df4; border-color: #2a6df4; color: #fff; }
.help.is-danger { color: #c0392b; }
.has-text-grey { color: #777; } .has-text-weight-bold { font-weight: 700; } .has-text-weight-semibold { font-weight: 600; }
.mb-3 { margin-bottom: 0.75rem; } .mb-5 { margin-bottom: 1.5rem; }
