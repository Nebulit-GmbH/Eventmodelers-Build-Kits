import { Link } from 'react-router-dom';
import { HOME_ROUTE } from './model';

/** Shown for an address the app has no page for. Distinct from NotBuilt, which marks a modeled feature not built yet. */
export function NotFound() {
  return (
    <div className="notification" role="status">
      <p className="has-text-weight-semibold">Page not found</p>
      <p>There is no page at this address. <Link to={HOME_ROUTE}>Go to the home page</Link> or pick a timeline from the navigation.</p>
    </div>
  );
}
