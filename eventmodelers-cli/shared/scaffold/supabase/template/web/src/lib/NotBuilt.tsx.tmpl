import { NOT_BUILT_MESSAGE } from './api';

/** Placeholder for a feature whose slice is not built yet, shown instead of an error. Pair with `isNotBuilt(err)` from `./api`. */
export function NotBuilt({ detail, compact = false }: { detail?: string; compact?: boolean }) {
  if (compact) return <span className="tag is-warning is-light">{NOT_BUILT_MESSAGE}</span>;
  return (
    <div className="notification is-warning is-light" role="status">
      <p className="has-text-weight-semibold">{NOT_BUILT_MESSAGE}</p>
      {detail && <p>{detail}</p>}
    </div>
  );
}
