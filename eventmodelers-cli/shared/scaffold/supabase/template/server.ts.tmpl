import {join} from 'path';
import {spawnSync} from 'child_process';
import net from 'net';
import {getApplication, startAPI, WebApiSetup} from '@event-driven-io/emmett-expressjs';
import {glob} from "glob";
import express, {Application, Request, Response} from 'express';
import {jsonBigIntReplacer} from './src/util/sanitize';
import {requireUser} from "./src/supabase/requireUser";
import {notImplemented} from "./src/common/notImplemented";
import {closeDb} from "./src/common/db";
import swaggerUi from 'swagger-ui-express'
import {specs} from './src/swagger';
import cors from 'cors';
import {findEventstore} from "./src/common/loadPostgresEventstore";
import {PostgresEventStore} from "@event-driven-io/emmett-postgresql";

// Generated by `eventmodelers scaffold`. Slice work never edits this file (blocked-paths check).

// Run as TypeScript (tsx watch in dev, ts-node in start) or compiled (dist/server.js): either way the slices
// sit next to this file, with the matching extension.
const ext = __filename.endsWith('.ts') ? 'ts' : 'js';

// Dev only: apply Flyway migrations on every (re)start, so a slice's new migration reaches the running app
// with the same hot reload as its code.
function migrate() {
    if (process.env.AUTO_MIGRATE !== 'true') return;
    const result = spawnSync('flyway', ['-configFiles=flyway.conf', '-baselineOnMigrate=true', 'migrate'], {
        cwd: process.cwd(), env: process.env, encoding: 'utf8',
    });
    if (result.status === 0) console.log('Flyway: migrations applied');
    else console.error(`Flyway migrate failed (fix the migration and save to retry):\n${result.stdout ?? ''}${result.stderr ?? result.error ?? ''}`);
}

function assertPortFree(port: number): Promise<void> {
    return new Promise((resolve, reject) => {
        const probe = net.createServer()
            .once('error', () => reject(new Error(`Port ${port} is in use. Stop whatever holds it (macOS/Linux: lsof -nP -iTCP:${port} -sTCP:LISTEN; Windows: netstat -ano) or change PORT in .env and skeleton.json.`)))
            .once('listening', () => probe.close(() => resolve()))
            .listen(port);
    });
}

async function startServer() {
    const port = parseInt(process.env.PORT || '__API_PORT__', 10);
    await assertPortFree(port);
    migrate();

    const eventStore = await findEventstore()
    const slicesBase = join(__dirname, 'src/slices');

    const routeFiles = await glob(join(slicesBase, `**/routes{,-*}.${ext}`), {nodir: true});
    console.log('Found route files:', routeFiles);

    const processorFiles = await glob(join(slicesBase, `**/processor{,-*}.${ext}`), {nodir: true});
    console.log('Found processor files:', processorFiles);

    // Common routes (e.g. projection replay) are privileged/operational and are
    // only mounted when explicitly enabled via env.
    const commonRoutesEnabled = process.env.COMMON_ROUTES_ENABLED === 'true';
    const commonRouteFiles = commonRoutesEnabled
        ? await glob(join(__dirname, `src/common/routes{,-*}.${ext}`), {nodir: true})
        : [];

    const rootApp: Application = express();
    rootApp.set('json replacer', jsonBigIntReplacer);

    const corsOrigins = process.env.CORS_ORIGINS?.split(',').map(o => o.trim()) ?? ['http://localhost:__WEB_PORT__', 'http://127.0.0.1:__WEB_PORT__'];
    rootApp.use(cors({
        origin: corsOrigins,
        credentials: true,
        methods: ['GET', 'POST', 'PUT', 'DELETE', 'PATCH', 'OPTIONS'],
        allowedHeaders: ['Content-Type', 'Content-Encoding', 'accept-encoding', 'Authorization', 'x-user-id', 'x-causation-id', 'x-correlation-id']
    }));

    const webApis: WebApiSetup[] = [];
    for (const file of routeFiles.concat(commonRouteFiles)) {
        const webApiModule: { api: () => WebApiSetup } = await import(file);
        if (typeof webApiModule.api == 'function') {
            webApis.push(webApiModule.api());
        } else {
            console.error(`Expected api function to be defined in ${file}`);
        }
    }

    const startedProcessors: Array<{ stop: () => Promise<void> }> = [];
    for (const processorFile of processorFiles) {
        const processor: { processor: { start: (eventStore: PostgresEventStore) => Promise<void>; stop: () => Promise<void> } } = await import(processorFile);
        if (typeof processor.processor?.start == "function") {
            console.log(`starting processor ${processorFile}`)
            processor.processor.start(eventStore).catch(err => console.error(`Processor ${processorFile} failed:`, err));
            startedProcessors.push(processor.processor);
        }
    }

    const shutdown = async (signal: string) => {
        console.log(`${signal} received, shutting down processors...`);
        await Promise.allSettled(startedProcessors.map(p => p.stop()));
        await eventStore.close();
        await closeDb();
        process.exit(0);
    };
    process.on('SIGINT', () => shutdown('SIGINT'));
    process.on('SIGTERM', () => shutdown('SIGTERM'));

    const childApp: Application = getApplication({
        apis: webApis,
        disableJsonMiddleware: false,
        enableDefaultExpressEtag: true,
    });
    childApp.set('json replacer', jsonBigIntReplacer);

    // Signed-in user info
    childApp.get('/api/user', async (req: Request, res: Response) => {
        const result = await requireUser(req, res, false)
        if (result.error) {
            if (!res.headersSent) res.status(401).json({error: result.error})
        } else {
            res.status(200).json({user_id: result.user.id, email: result.user.email, metadata: result.user.user_metadata})
        }
    });

    childApp.use('/api-docs', swaggerUi.serve);
    childApp.get('/api-docs', swaggerUi.setup(specs, {swaggerOptions: {urls: [{url: '/swagger.json', name: 'JSON'}]}}));
    childApp.get('/swagger.json', (_req: Request, res: Response) => {
        res.setHeader('Content-Type', 'application/json');
        res.send(specs);
    });

    rootApp.use((req: Request, _res: Response, next) => {
        console.log(`[${req.method}] ${req.path}`);
        next();
    });
    rootApp.use(express.json());

    rootApp.get('/health', (_req: Request, res: Response) => {
        res.json({ok: true, routes: routeFiles.length, processors: processorFiles.length});
    });

    // Closed-by-default auth gate: every route requires a valid Supabase JWT
    // except the explicitly public paths below. New slice routes are protected
    // even if a handler forgets to call requireUser.
    const PUBLIC_PATHS = ['/api-docs', '/swagger.json', '/health'];
    const isPublicPath = (p: string): boolean =>
        PUBLIC_PATHS.some(pub => p === pub || p.startsWith(pub + '/'));
    rootApp.use(async (req: Request, res: Response, next) => {
        if (req.method === 'OPTIONS') return next();
        if (isPublicPath(req.path)) return next();
        const {error} = await requireUser(req, res);
        if (error) return;
        next();
    });

    rootApp.use(childApp)
    // After every real route: modeled endpoints that are not built yet answer 501, not 404.
    rootApp.use(notImplemented)

    startAPI(rootApp, {port});
    console.log(`> Ready on port ${port}`);

    process.on('unhandledRejection', (reason) => {
        console.error('⛔ Unhandled Rejection:', reason);
    });
}

startServer().catch(error => {
    console.error('Failed to start server:', error);
    process.exit(1);
});
