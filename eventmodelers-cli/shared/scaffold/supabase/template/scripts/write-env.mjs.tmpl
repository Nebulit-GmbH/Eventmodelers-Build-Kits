// Writes .env and web/.env from the running local Supabase stack (`supabase status`) and the ports in
// skeleton.json. Keys it does not manage are kept. Run by `npm run up`; safe to run any time.
import {execFileSync} from 'node:child_process';
import {existsSync, readFileSync, writeFileSync} from 'node:fs';

const {apiPort, webPort} = JSON.parse(readFileSync('skeleton.json', 'utf8'));
const status = JSON.parse(execFileSync('supabase', ['status', '-o', 'json'], {encoding: 'utf8', stdio: ['ignore', 'pipe', 'ignore']}));
const dbPort = new URL(status.DB_URL).port;

function upsert(file, values) {
    const lines = existsSync(file) ? readFileSync(file, 'utf8').split('\n') : [];
    const seen = new Set();
    const out = lines.map((line) => {
        const key = line.match(/^([A-Z0-9_]+)=/)?.[1];
        if (key && key in values) {
            seen.add(key);
            return `${key}=${values[key]}`;
        }
        return line;
    });
    for (const [k, v] of Object.entries(values)) if (!seen.has(k)) out.push(`${k}=${v}`);
    writeFileSync(file, out.join('\n').replace(/\n*$/, '\n'));
}

upsert('.env', {
    SUPABASE_URL: status.API_URL,
    SUPABASE_PUBLISHABLE_KEY: status.ANON_KEY,
    SUPABASE_SECRET_KEY: status.SERVICE_ROLE_KEY,
    SUPABASE_DB_URL: status.DB_URL,
    FLYWAY_URL: `jdbc:postgresql://127.0.0.1:${dbPort}/postgres`,
    FLYWAY_USER: 'postgres',
    FLYWAY_PASSWORD: 'postgres',
    PORT: apiPort,
    API_URL: `http://localhost:${apiPort}`,
    BACKEND_URL: `http://localhost:${apiPort}`,
    CORS_ORIGINS: `http://localhost:${webPort},http://127.0.0.1:${webPort}`,
    AUTO_MIGRATE: 'true',
});
upsert('web/.env', {
    VITE_SUPABASE_URL: status.API_URL,
    VITE_SUPABASE_ANON_KEY: status.ANON_KEY,
    VITE_API_BASE: `http://localhost:${apiPort}`,
});
console.log(`.env and web/.env written (Supabase ${status.API_URL}, API :${apiPort}, web :${webPort})`);
